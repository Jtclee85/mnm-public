# AI 공급자: gemini(공개용 기본값) | openai(롤백용). 바꾸면 다시 빌드(dev 서버 재시작)해야 한다.
AI_PROVIDER=gemini

# 학급 모드(AI_PROVIDER=gemini): 교사가 /teacher에서 Gemini/OpenAI를 선택하고 자기 키로 학급 코드를 만든다.
# 학급 코드 저장소(Upstash Redis REST). Vercel Marketplace 연결 시 KV_REST_API_URL/KV_REST_API_TOKEN도 읽는다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 교사 키 암호화용 비밀값(32자 이상 무작위 문자열, 예: openssl rand -base64 48). 바꾸면 기존 학급 코드가 무효가 된다.
CLASS_KEY_SECRET=
# 선택: 10분당 틀린 학급 코드 허용 횟수(기본 10)
# CLASS_FAILURE_LIMIT=10

# 서버 공용 키 롤백 모드(AI_PROVIDER=openai)에서만 필요하다. 교사용 OpenAI 키는 화면에서 입력한다.
OPENAI_API_KEY=sk-

YOUTUBE_API_KEY=your_youtube_data_api_key_here
